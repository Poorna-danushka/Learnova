# PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/nexora

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
AI_DAILY_REQUEST_LIMIT=20
AI_MAX_INPUT_CHARS=120000

# AWS S3 Storage
# Keep the bucket private. In production, prefer an IAM task/instance role
# and leave the access-key fields empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
STORAGE_BACKEND=local

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_SECONDS=30

# Debug Mode
APP_ENV=development
DEBUG=True
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Transactional email (Resend). Development safely logs a no-op when unset;
# production requires both values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_URL=http://localhost:8081
# APP_URL is accepted as an alias for FRONTEND_URL.
APP_URL=http://localhost:8081
EMAIL_VERIFICATION_URL=http://localhost:8081/verify-email
PASSWORD_RESET_URL=http://localhost:8081/reset-password
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
